    "build": "vite build && esbuild server/boot.ts --platform=node --bundle --format=esm --outdir=dist --external:postgres --external:@hono/node-server --external:drizzle-orm --banner:js=\"import { createRequire } from 'module';const require = createRequire(import.meta.url);\"",
